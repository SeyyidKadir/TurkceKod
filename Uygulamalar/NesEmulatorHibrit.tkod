// ========== JS: Emülatör + Text ile buton bulma ==========
JSKod("
  var container = document.createElement('div');
  container.style.cssText = 'position:absolute;left:10px;top:30px;width:512px;height:480px;';
  document.getElementById('pov').querySelector('.sw').appendChild(container);
  
  var browser = new jsnes.Browser({container: container});
  window.__nesBrowser = browser;
  window.__romLoaded = false;
  
  // Tuş eşlemesi - TEXT içeriğine göre
  var textToKey = {
    '▲': {key:'ArrowUp', code:'ArrowUp', keyCode:38, which:38},
    '▼': {key:'ArrowDown', code:'ArrowDown', keyCode:40, which:40},
    '◀': {key:'ArrowLeft', code:'ArrowLeft', keyCode:37, which:37},
    '▶': {key:'ArrowRight', code:'ArrowRight', keyCode:39, which:39},
    'A': {key:'x', code:'KeyX', keyCode:88, which:88},
    'B': {key:'z', code:'KeyZ', keyCode:90, which:90},
    'START': {key:'Enter', code:'Enter', keyCode:13, which:13},
    'SELECT': {key:'Shift', code:'ShiftRight', keyCode:16, which:16}
  };
  
  var activeKeys = {};
  
  function sendKey(text, down) {
    if(!window.__romLoaded) return;
    var k = textToKey[text];
    if(!k) return;
    
    var ev = new KeyboardEvent(down ? 'keydown' : 'keyup', {
      key: k.key, code: k.code, keyCode: k.keyCode,
      which: k.which, bubbles: true, cancelable: true
    });
    window.dispatchEvent(ev);
    document.dispatchEvent(ev);
    document.body.dispatchEvent(ev);
  }
  
  setTimeout(function() {
    var pov = document.getElementById('pov');
    var butonlar = pov.querySelectorAll('button.sbtn');
    
    butonlar.forEach(function(btn) {
      var text = btn.textContent.trim();
      if(!textToKey[text]) return;
      
      btn.addEventListener('mousedown', function(e) {
        e.preventDefault();
        sendKey(text, true);
        activeKeys[text] = true;
      });
      btn.addEventListener('mouseup', function(e) {
        e.preventDefault();
        if(activeKeys[text]) { sendKey(text, false); activeKeys[text] = false; }
      });
      btn.addEventListener('mouseleave', function(e) {
        if(activeKeys[text]) { sendKey(text, false); activeKeys[text] = false; }
      });
      btn.addEventListener('touchstart', function(e) {
        e.preventDefault();
        sendKey(text, true);
        activeKeys[text] = true;
      });
      btn.addEventListener('touchend', function(e) {
        e.preventDefault();
        if(activeKeys[text]) { sendKey(text, false); activeKeys[text] = false; }
      });
      btn.addEventListener('touchcancel', function(e) {
        if(activeKeys[text]) { sendKey(text, false); activeKeys[text] = false; }
      });
    });
  }, 1000);
");

btnROM.tiklaninca = Fonksiyon()
  Varyant dosya = DosyaAkimi(".nes");
  Eger dosya Ise
    Dizi j = dosya.baytlar;
    lbl.yazi = "Yükleniyor...";
    Metin json = JSONMetineDonustur(j);
    Varyant r = JSKod("
      var arr = JSON.parse('" + json + "');
      var rom = new Uint8Array(arr.length);
      for(var i=0; i<arr.length; i++) rom[i] = arr[i];
      try { window.__nesBrowser.loadROM(rom); window.__romLoaded = true; return 'OK'; }
      catch(e) { return 'HATA:'+e.message; }
    ");
    Eger r == "OK" Ise
      lbl.yazi = "✅ " + dosya.ad;
      lbl.renk = "#4ade80";
    Degilse
      lbl.yazi = "❌ " + r;
      lbl.renk = "#e63946";
    EgerBitti
  EgerBitti
FonksiyonBitti

Yaz("🎮 Butonlar TEXT ile bulundu!");
