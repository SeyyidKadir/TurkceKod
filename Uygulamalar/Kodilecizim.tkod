// ===== SATIR TEMIZLEME (CALISAN YONTEM) =====
Fonksiyon satirTemizle(kod)
  Metin rChar = KaraktereKonvert(13);
  Metin nChar = KaraktereKonvert(10);
  Metin temizKod = MetinDegistir(kod, rChar + nChar, nChar);
  temizKod = MetinDegistir(temizKod, rChar, nChar);
  Don MetinBol(temizKod, nChar);
FonksiyonBitti

// ===== RENK CEVIRME =====
Fonksiyon renkCevir(renk)
  Eger renk == "kirmizi" Ise Don "#e63946"; EgerBitti
  Eger renk == "mavi" Ise Don "#1f6feb"; EgerBitti
  Eger renk == "yesil" Ise Don "#2ec4b6"; EgerBitti
  Eger renk == "sari" Ise Don "#ffd700"; EgerBitti
  Eger renk == "siyah" Ise Don "#000000"; EgerBitti
  Eger renk == "turuncu" Ise Don "#f4a261"; EgerBitti
  Eger renk == "mor" Ise Don "#a78bfa"; EgerBitti
  Eger renk == "beyaz" Ise Don "#ffffff"; EgerBitti
  Eger renk == "pembe" Ise Don "#f472b6"; EgerBitti
  Don renk;
FonksiyonBitti

// ===== ANA CIZIM =====
Fonksiyon cizimYap(kod)
  Dizi satirlar = satirTemizle(kod);
  Metin renk = "#000000";
  Sayi kalinlik = 2;
  Sayi cizilen = 0;
  
  Sayi i = 0;
  Tekrarla DiziUzunluk(satirlar) Kez
    Metin satir = MetinBosYer(satirlar[i]);
    
    Eger MetinIceriyorMu(satir, "KalemRenk") Ise
      Dizi p = MetinBol(satir, " ");
      Eger DiziUzunluk(p) >= 2 Ise
        renk = renkCevir(MetinBosYer(p[1]));
        cizilen = cizilen + 1;
      EgerBitti
    EgerBitti
    
    Eger MetinIceriyorMu(satir, "Kalem") Ve !MetinIceriyorMu(satir, "KalemRenk") Ise
      Dizi p = MetinBol(satir, " ");
      Eger DiziUzunluk(p) >= 2 Ise
        kalinlik = SayiyaKonvert(MetinBosYer(p[1]));
        Eger kalinlik < 1 Ise kalinlik = 1; EgerBitti
        cizilen = cizilen + 1;
      EgerBitti
    EgerBitti
    
    Eger MetinIceriyorMu(satir, "Cizgi") Ise
      Dizi p = MetinBol(satir, " ");
      Eger DiziUzunluk(p) >= 5 Ise
        KanvasCizgi(kv, SayiyaKonvert(p[1]), SayiyaKonvert(p[2]), SayiyaKonvert(p[3]), SayiyaKonvert(p[4]), renk, kalinlik);
        cizilen = cizilen + 1;
      EgerBitti
    EgerBitti
    
    Eger MetinIceriyorMu(satir, "Dikdortgen") Ise
      Dizi p = MetinBol(satir, " ");
      Eger DiziUzunluk(p) >= 5 Ise
        KanvasDikdortgen(kv, SayiyaKonvert(p[1]), SayiyaKonvert(p[2]), SayiyaKonvert(p[3]), SayiyaKonvert(p[4]), renk);
        cizilen = cizilen + 1;
      EgerBitti
    EgerBitti
    
    Eger MetinIceriyorMu(satir, "Daire") Ise
      Dizi p = MetinBol(satir, " ");
      Eger DiziUzunluk(p) >= 4 Ise
        Metin dr = renk;
        Eger DiziUzunluk(p) >= 5 Ise dr = renkCevir(p[4]); EgerBitti
        KanvasDaire(kv, SayiyaKonvert(p[1]), SayiyaKonvert(p[2]), SayiyaKonvert(p[3]), dr);
        cizilen = cizilen + 1;
      EgerBitti
    EgerBitti
    
    Eger MetinIceriyorMu(satir, "Metin") Ise
      Dizi p = MetinBol(satir, " ");
      Eger DiziUzunluk(p) >= 5 Ise
        Metin mr = renk;
        Eger DiziUzunluk(p) >= 6 Ise mr = renkCevir(p[5]); EgerBitti
        KanvasMetin(kv, p[1], SayiyaKonvert(p[2]), SayiyaKonvert(p[3]), mr, p[4] + "px Arial");
        cizilen = cizilen + 1;
      EgerBitti
    EgerBitti
    
    i = i + 1;
  TekrarlaBitti
  
  lblDurum.yazi = "✅ Cizildi: " + cizilen + " komut";
  lblDurum.renk = "#4ade80";
FonksiyonBitti

// ===== BUTON OLAYLARI =====
btnCalistir.tiklaninca = Fonksiyon()
  KanvasTemizle(kv);
  KanvasArkaplan(kv, "#ffffff");
  lblDurum.yazi = "⏳ Ciziliyor...";
  lblDurum.renk = "#ffd700";
  cizimYap(cm.deger);
FonksiyonBitti

btnTemizle.tiklaninca = Fonksiyon()
  KanvasTemizle(kv);
  KanvasArkaplan(kv, "#ffffff");
  cm.deger = "";
  lblDurum.yazi = "🟢 Temizlendi";
FonksiyonBitti

